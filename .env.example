# ==========================================
# RoadMate Backend Environment Configuration
# ==========================================

# Django Core Settings
DJANGO_SETTINGS_MODULE=roadmate.settings.development
SECRET_KEY=django-insecure-roadmate-super-secret-key-change-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# PostGIS Database Configuration
# Format: postgis://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgis://roadmate_user:roadmate_secure_pass@localhost:5432/roadmate_db
POSTGRES_DB=roadmate_db
POSTGRES_USER=roadmate_user
POSTGRES_PASSWORD=roadmate_secure_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Channel Layers (WebSockets & Caching)
REDIS_URL=redis://localhost:6379/1

# CORS Allowed Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Razorpay Payment Gateway Credentials (Test Keys)
RAZORPAY_KEY_ID=rzp_test_roadmate_key_123456789
RAZORPAY_KEY_SECRET=roadmate_razorpay_secret_987654321
RAZORPAY_WEBHOOK_SECRET=roadmate_whsec_secret_key_112233

# Dispatch Engine Settings
DISPATCH_RADIUS_STEPS=3,5,8,10
DISPATCH_OFFER_EXPIRY_MINUTES=10
